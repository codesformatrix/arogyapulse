# --- runtime (all optional: the app boots with zero configuration) ---
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# repository: auto | memory | firestore   (auto -> firestore when a project is set)
REPOSITORY=auto
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE=(default)

# seed demo data on boot when the repository is empty
SEED_ON_BOOT=true
SEED_DAYS=45

# demo auth (signed JWT cookie). Set a real 32+ char secret in production.
DEMO_MODE=true
SESSION_SECRET=change-me-to-a-random-32-character-secret
COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800

# Firebase Auth ID tokens (optional; takes priority over demo cookies)
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_ENABLED=false

# Gemini (optional; unset -> deterministic rule-based "basic mode")
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=8000

# CORS allowlist, comma separated
CORS_ORIGINS=

# rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AI_MAX=20
